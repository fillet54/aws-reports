# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=reports.example.com,localhost
# Needed when served over HTTPS on a custom domain, e.g. https://reports.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set to 1 once the app is behind HTTPS (secure cookies, HSTS).
DJANGO_HTTPS=0

# Encrypts SP-API refresh tokens in the database. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

POSTGRES_PASSWORD=reports

# Amazon: "dummy" until the SP-API app is registered, then "sp_api".
AMAZON_CLIENT=dummy
SP_API_LWA_APP_ID=
SP_API_LWA_CLIENT_SECRET=

REPORT_TIME_ZONE=America/Los_Angeles
